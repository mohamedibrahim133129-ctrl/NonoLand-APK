# PostgreSQL (Neon / Cloud SQL) Runtime & Migration Configuration
# Configure these in Google AI Studio Secrets (never commit real credentials).
# For Neon PostgreSQL:
# - SQL_HOST: pooled endpoint (e.g. ep-xxxx-pooler.<region>.aws.neon.tech)
# - SQL_DIRECT_HOST: optional direct unpooled endpoint for Drizzle migrations (ep-xxxx.<region>.aws.neon.tech)
SQL_HOST=""
SQL_DIRECT_HOST=""
SQL_PORT="5432"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
SQL_SSL="true"
SQL_POOL_MAX="10"
SQL_CONNECTION_TIMEOUT_MS="15000"
REQUIRE_POSTGRES="false"


# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Optional server-side YouTube Data API v3 key for fetching
# uploads from the official NonoLand channel (@Future-p6l). Never expose to client.
YOUTUBE_API_KEY=""

# ADMIN_PIN: Optional server-side Admin PIN (defaults to 2026 in development).
ADMIN_PIN=""

# Payment gateway keys (optional; uses development test verification if unset).
STRIPE_SECRET_KEY=""
PAYMOB_API_KEY=""

# Server-side secret for encrypting stored child access codes & signing cookies
SESSION_SECRET=""

# One-time setup secret for initializing the FIRST Super Admin account.
# Set a strong random secret in your deployment / AI Studio Secrets panel,
# complete the first-time Super Admin bootstrap once, and the system permanently
# disables bootstrap afterward. Never commit real secrets here.
NONOLAND_ADMIN_SETUP_SECRET=""

